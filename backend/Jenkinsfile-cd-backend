pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Tag image backend a deployer')
    }

    environment {
        K8S_NAMESPACE = 'pidev-prod'
        DOCKER_IMAGE = 'saif4584851/pidevxbm-backend'
        DEPLOYMENT_NAME = 'pidev-backend'
        CONTAINER_NAME = 'backend'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'contrat', url: 'https://github.com/AhmeDrira/PIDEVxBMP.git'
            }
        }

        stage('Verifier le cluster') {
            steps {
                withCredentials([file(credentialsId: 'KCFG', variable: 'KCFG')]) {
                    sh '''
                        export KUBECONFIG="$KCFG"
                        kubectl cluster-info
                        kubectl get nodes
                        kubectl -n ${K8S_NAMESPACE} get pods -l app=pidev-backend
                    '''
                }
            }
        }

        stage('Appliquer les manifests backend') {
            steps {
                withCredentials([file(credentialsId: 'KCFG', variable: 'KCFG')]) {
                    sh '''
                        export KUBECONFIG="$KCFG"
                        kubectl apply -f k8s/backend-service.yaml
                        kubectl apply -f k8s/backend-deployment.yaml
                    '''
                }
            }
        }

        stage('Mise a jour image backend') {
            steps {
                withCredentials([file(credentialsId: 'KCFG', variable: 'KCFG')]) {
                    sh '''
                        export KUBECONFIG="$KCFG"
                        echo "Mise a jour vers: ${DOCKER_IMAGE}:${IMAGE_TAG}"
                        kubectl -n ${K8S_NAMESPACE} set image deployment/${DEPLOYMENT_NAME} ${CONTAINER_NAME}=${DOCKER_IMAGE}:${IMAGE_TAG}
                    '''
                }
            }
        }

        stage('Verifier rollout') {
            steps {
                withCredentials([file(credentialsId: 'KCFG', variable: 'KCFG')]) {
                    sh '''
                        export KUBECONFIG="$KCFG"
                        kubectl -n ${K8S_NAMESPACE} rollout status deployment/${DEPLOYMENT_NAME} --timeout=300s
                        kubectl -n ${K8S_NAMESPACE} get pods -l app=pidev-backend -o wide
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "CD Backend reussi - Image: ${DOCKER_IMAGE}:${IMAGE_TAG}"
        }
        failure {
            echo "CD Backend echoue - Rollback"
            withCredentials([file(credentialsId: 'KCFG', variable: 'KCFG')]) {
                sh '''
                    export KUBECONFIG="$KCFG"
                    kubectl -n ${K8S_NAMESPACE} rollout undo deployment/${DEPLOYMENT_NAME}
                '''
            }
        }
        always {
            cleanWs()
        }
    }
}
