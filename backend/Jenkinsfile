pipeline {
    agent any

   
    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        APP_DIR = 'backend'
        DOCKER_IMAGE = 'ahmedrira/pidevxbmp-backend'
        DOCKER_TAG = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'test_unitaire', url: 'https://github.com/AhmeDrira/PIDEVxBMP.git'
            }
        }
        stage('Install Dependencies') {
    steps {
        dir("${APP_DIR}") {
            sh 'npm install'
        }
    }
}
        

        

        stage('Run Unit Tests') {
            steps {
                dir("${APP_DIR}") {
                    sh 'npm test || echo "No tests configured yet"'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir("${APP_DIR}") {
                    withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                        sh '''
                            npx --yes sonar-scanner \
                              -Dsonar.projectKey=pidevxbmp-backend \
                              -Dsonar.projectName=PIDEVxBMP \
                              -Dsonar.sources=. \
                              -Dsonar.exclusions=node_modules/**,coverage/** \
                              -Dsonar.host.url=http://localhost:9000 \
                              -Dsonar.token=$SONAR_TOKEN
                        '''
                    }
                }
            }
        }

        stage('Build Docker Image') {
            when {
                expression { fileExists('Dockerfile') || fileExists('backend/Dockerfile') }
            }
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} .
                        docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${DOCKER_IMAGE}:latest
                    '''
                }
            }
        }

        stage('Push Docker Image') {
            when {
                expression { fileExists('Dockerfile') || fileExists('backend/Dockerfile') }
            }
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh '''
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                        docker push ${DOCKER_IMAGE}:latest
                        docker logout
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'CI terminée avec succès pour PIDEVxBMP'
        }
        failure {
            echo 'CI échouée, vérifier les logs'
        }
        always {
            cleanWs()
        }
    }
}
