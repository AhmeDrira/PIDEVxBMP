pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        APP_DIR = 'backend'
        DOCKER_IMAGE = 'ahmedrira/pidevxbmp-backend'
        DOCKER_TAG = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'test_unitaire', url: 'https://github.com/AhmeDrira/PIDEVxBMP.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir("${APP_DIR}") {
                    sh 'npm install'
                }
            }
        }

        stage('Run Unit Tests') {
            steps {
                dir("${APP_DIR}") {
                    sh 'npm test || echo "No tests configured yet"'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir("${APP_DIR}") {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            sonar-scanner \
                              -Dsonar.projectKey=pidevxbmp-backend \
                              -Dsonar.projectName=PIDEVxBMP \
                              -Dsonar.sources=. \
                              -Dsonar.exclusions=node_modules/**,coverage/** \
                              -Dsonar.host.url=http://localhost:9000
                        '''
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${APP_DIR}") {
                    script {
                        docker.build("${DOCKER_IMAGE}:${DOCKER_TAG}")
                        docker.tag("${DOCKER_IMAGE}:${DOCKER_TAG}", "${DOCKER_IMAGE}:latest")
                    }
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                dir("${APP_DIR}") {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        script {
                            docker.withRegistry('', "${DOCKER_USER}:${DOCKER_PASS}") {
                                docker.image("${DOCKER_IMAGE}:${DOCKER_TAG}").push()
                                docker.image("${DOCKER_IMAGE}:latest").push()
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo '✅ CI terminée avec succès pour PIDEVxBMP'
            echo "📦 Image Docker: ${DOCKER_IMAGE}:${DOCKER_TAG}"
        }
        failure {
            echo '❌ CI échouée, vérifier les logs'
        }
        always {
            cleanWs()
        }
    }
}
