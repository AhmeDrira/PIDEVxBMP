pipeline {
    agent any
    options {
        timestamps()
        disableConcurrentBuilds()
    }
    environment {
        APP_DIR = 'backend'
        DOCKER_IMAGE = 'saif4584851/pidevxbm-backend'
        DOCKER_TAG = "${BUILD_NUMBER}"
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'contrat', url: 'https://github.com/AhmeDrira/PIDEVxBMP.git'
            }
        }
        stage('Install Dependencies') {
            steps {
                dir("${APP_DIR}") {
                    sh 'npm install'
                }
            }
        }
        stage('Run Unit Tests') {
            steps {
                dir("${APP_DIR}") {
                    sh 'npm test || echo "No tests configured yet"'
                }
            }
        }
        stage('Generate Coverage Report') {
            steps {
                dir("${APP_DIR}") {
                    sh 'npm run test:coverage || true'
                }
            }
        }
        stage('SonarQube Analysis') {
            steps {
                dir("${APP_DIR}") {
                    withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                        sh '''
                            sonar-scanner \
                              -Dsonar.projectKey=pidevxbmp-backend \
                              -Dsonar.projectName=PIDEVxBMP \
                              -Dsonar.sources=. \
                              -Dsonar.exclusions=node_modules/**,coverage/** \
                              -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \
                              -Dsonar.host.url=http://localhost:9000 \
                              -Dsonar.login=$SONAR_TOKEN
                        '''
                    }
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} .
                        docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${DOCKER_IMAGE}:latest
                    '''
                }
            }
        }
        stage('Push Docker Image') {
            steps {
                dir("${APP_DIR}") {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        sh '''
                            echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                            docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                            docker push ${DOCKER_IMAGE}:latest
                            docker logout
                        '''
                    }
                }
            }
        }
    }
    post {
        success {
            echo 'CI terminee avec succes pour PIDEVxBMP Backend'
            echo "Image Docker: ${DOCKER_IMAGE}:${DOCKER_TAG}"
            build job: 'cd-backend',
                  parameters: [
                      string(name: 'IMAGE_TAG', value: "${DOCKER_TAG}")
                  ],
                  wait: false
        }
        failure {
            echo 'CI echouee, verifier les logs'
        }
        always {
            cleanWs()
        }
    }
}
