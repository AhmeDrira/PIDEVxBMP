<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= profile.fullName %><%= profile.domain ? ' — ' + profile.domain : '' %></title>
<meta name="description" content="<%= meta.description %>">
<link rel="canonical" href="<%= meta.url %>">
<link rel="icon" href="<%= meta.avatarPath %>" type="image/svg+xml">

<!-- Partage WhatsApp / réseaux sociaux -->
<meta property="og:type" content="profile">
<meta property="og:site_name" content="BMP">
<meta property="og:title" content="<%= meta.title %>">
<meta property="og:description" content="<%= meta.description %>">
<meta property="og:url" content="<%= meta.url %>">
<meta property="og:image" content="<%= meta.image %>">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="<%= meta.imageWidth %>">
<meta property="og:image:height" content="<%= meta.imageHeight %>">
<meta property="og:image:alt" content="<%= profile.fullName %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= meta.title %>">
<meta name="twitter:description" content="<%= meta.description %>">

<style>
  :root {
    --brand: #1F3A8A;
    --brand-soft: #EEF2FF;
    --whatsapp: #25D366;
    --ink: #0F172A;
    --muted: #64748B;
    --line: #E2E8F0;
    --surface: #FFFFFF;
    --bg: #F8FAFC;
    --radius: 16px;
    --shadow: 0 1px 2px rgba(15, 23, 42, .04), 0 8px 24px rgba(15, 23, 42, .06);
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --brand: #93B4FF;
      --brand-soft: #1E293B;
      --ink: #F1F5F9;
      --muted: #94A3B8;
      --line: #1E293B;
      --surface: #0F172A;
      --bg: #020617;
      --shadow: 0 1px 2px rgba(0, 0, 0, .3), 0 8px 24px rgba(0, 0, 0, .35);
    }
  }

  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 16px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  img { max-width: 100%; display: block; }
  a { color: inherit; }

  .wrap { max-width: 720px; margin: 0 auto; padding: 0 20px; }
  section { margin-top: 28px; }
  h2 {
    font-size: 13px; letter-spacing: .08em; text-transform: uppercase;
    color: var(--muted); margin: 0 0 14px; font-weight: 600;
  }
  .card {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--radius); box-shadow: var(--shadow);
  }

  /* ── Hero ─────────────────────────────────────────────── */
  .hero {
    background: linear-gradient(160deg, var(--brand) 0%, color-mix(in srgb, var(--brand) 70%, #000) 100%);
    padding: 44px 0 68px;
    color: #fff;
    text-align: center;
  }
  @supports not (background: color-mix(in srgb, red 50%, blue)) {
    .hero { background: var(--brand); }
  }
  .avatar {
    width: 112px; height: 112px; border-radius: 50%;
    margin: 0 auto 18px; overflow: hidden;
    border: 4px solid rgba(255, 255, 255, .9);
    box-shadow: 0 8px 28px rgba(0, 0, 0, .22);
    background: #fff;
  }
  .avatar img { width: 100%; height: 100%; object-fit: cover; }
  .hero h1 { margin: 0 0 10px; font-size: 28px; line-height: 1.25; font-weight: 700; }
  .trade {
    display: inline-block; padding: 5px 14px; border-radius: 999px;
    background: rgba(255, 255, 255, .18); font-size: 14px; font-weight: 600;
  }
  .zone {
    margin: 12px 0 0; font-size: 15px;
    color: rgba(255, 255, 255, .85);
    display: flex; align-items: center; justify-content: center; gap: 6px;
  }

  /* ── Boutons ──────────────────────────────────────────── */
  .actions {
    margin-top: 24px; display: flex; gap: 10px;
    justify-content: center; flex-wrap: wrap;
  }
  .btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 13px 22px; border-radius: 999px;
    font-size: 15px; font-weight: 600; text-decoration: none;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .btn:hover { transform: translateY(-1px); }
  .btn:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  .btn-wa { background: var(--whatsapp); color: #062512; box-shadow: 0 6px 18px rgba(37, 211, 102, .35); }
  .btn-ghost { background: rgba(255, 255, 255, .16); color: #fff; border: 1px solid rgba(255, 255, 255, .3); }

  /* ── Stats ────────────────────────────────────────────── */
  .stats {
    margin-top: -40px; display: grid; gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
    background: var(--line); border: 1px solid var(--line);
    border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow);
  }
  .stat { background: var(--surface); padding: 16px 10px; text-align: center; }
  .stat b { display: block; font-size: 20px; color: var(--brand); }
  .stat span { font-size: 12px; color: var(--muted); }

  /* ── Contenus ─────────────────────────────────────────── */
  .prose { padding: 20px; margin: 0; white-space: pre-line; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    padding: 6px 13px; border-radius: 999px; font-size: 13.5px; font-weight: 500;
    background: var(--brand-soft); color: var(--brand);
    border: 1px solid color-mix(in srgb, var(--brand) 18%, transparent);
  }

  .gallery { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .work { overflow: hidden; }
  .work-media { aspect-ratio: 4 / 3; background: var(--brand-soft); }
  .work-media img, .work-media video { width: 100%; height: 100%; object-fit: cover; }
  .work-body { padding: 14px 16px; }
  .work-body h3 { margin: 0 0 5px; font-size: 15.5px; font-weight: 600; }
  .work-body p { margin: 0; font-size: 13.5px; color: var(--muted); }
  .work-meta { margin-top: 8px; font-size: 12.5px; color: var(--muted); }

  .review { padding: 16px 18px; }
  .review + .review { border-top: 1px solid var(--line); }
  .stars { color: #F59E0B; letter-spacing: 2px; font-size: 14px; }
  .review p { margin: 8px 0 0; font-size: 14.5px; }
  .review .who { margin-top: 8px; font-size: 12.5px; color: var(--muted); }
  .empty { padding: 20px; margin: 0; color: var(--muted); font-size: 14.5px; text-align: center; }

  .contact { padding: 26px 20px; text-align: center; }
  .contact p { margin: 0 0 16px; color: var(--muted); font-size: 15px; }
  .contact .btn-wa { box-shadow: 0 6px 18px rgba(37, 211, 102, .3); }

  footer {
    margin: 36px 0 28px; text-align: center;
    font-size: 13px; color: var(--muted);
  }
  footer a { color: var(--brand); text-decoration: none; font-weight: 600; }

  @media (max-width: 480px) {
    .hero { padding: 34px 0 58px; }
    .hero h1 { font-size: 23px; }
    .btn { flex: 1 1 auto; justify-content: center; }
  }
</style>
</head>
<body>

<!-- ── 1. Hero ─────────────────────────────────────────── -->
<header class="hero">
  <div class="wrap">
    <div class="avatar">
      <img src="<%= profile.avatar %>" alt="<%= profile.fullName %>" width="112" height="112">
    </div>
    <h1><%= profile.fullName %></h1>

    <% if (profile.domain) { %>
      <span class="trade"><%= profile.domain %></span>
    <% } %>

    <% if (profile.location) { %>
      <p class="zone">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <%= profile.location %>
      </p>
    <% } %>

    <% if (profile.whatsappUrl) { %>
      <div class="actions">
        <a class="btn btn-wa" href="<%= profile.whatsappUrl %>" target="_blank" rel="noopener">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.2-.7.1-.2.3-.7 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.2-.7-1.6-.9-2.2-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.4 1.9.8 2.7.9 3.6.7.6-.1 1.7-.7 2-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3z"/><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2z"/></svg>
          Contacter sur WhatsApp
        </a>
        <a class="btn btn-ghost" href="tel:<%= profile.phone %>">Appeler</a>
      </div>
    <% } %>
  </div>
</header>

<div class="wrap">

  <!-- Repères chiffrés — uniquement ceux qui existent -->
  <% if (stats.length) { %>
    <div class="stats">
      <% stats.forEach(function (stat) { %>
        <div class="stat"><b><%= stat.value %></b><span><%= stat.label %></span></div>
      <% }); %>
    </div>
  <% } %>

  <!-- ── 2. Description — masquée si la bio est vide ────── -->
  <% if (profile.bio) { %>
    <section>
      <h2>À propos</h2>
      <div class="card"><p class="prose"><%= profile.bio %></p></div>
    </section>
  <% } %>

  <% if (profile.skills.length || profile.certifications.length) { %>
    <section>
      <h2>Compétences</h2>
      <div class="card" style="padding:18px">
        <div class="chips">
          <% profile.skills.forEach(function (skill) { %><span class="chip"><%= skill %></span><% }); %>
          <% profile.certifications.forEach(function (cert) { %><span class="chip"><%= cert %></span><% }); %>
        </div>
      </div>
    </section>
  <% } %>

  <!-- ── 3. Galerie — les réalisations du portfolio ─────── -->
  <section>
    <h2>Réalisations</h2>
    <% if (profile.portfolio.length) { %>
      <div class="gallery">
        <% profile.portfolio.forEach(function (item) { %>
          <article class="card work">
            <% var cover = item.media && item.media[0]; %>
            <% if (cover) { %>
              <div class="work-media">
                <% if (cover.type === 'video') { %>
                  <video src="<%= cover.url %>" controls preload="metadata"
                         onerror="this.closest('.work-media').remove()"></video>
                <% } else { %>
                  <%# Média manquant sur le disque : on retire le cadre plutôt que de laisser un trou gris %>
                  <img src="<%= cover.url %>" alt="<%= item.title %>" loading="lazy"
                       onerror="this.closest('.work-media').remove()">
                <% } %>
              </div>
            <% } %>
            <div class="work-body">
              <h3><%= item.title %></h3>
              <p><%= item.description %></p>
              <% if (item.location || item.completedDate) { %>
                <p class="work-meta">
                  <%= [item.location, item.completedDate ? new Date(item.completedDate).getFullYear() : null].filter(Boolean).join(' · ') %>
                </p>
              <% } %>
            </div>
          </article>
        <% }); %>
      </div>
    <% } else { %>
      <div class="card"><p class="empty">Réalisations à venir.</p></div>
    <% } %>
  </section>

  <!-- ── 4. Avis — masqués s'il n'y en a aucun ──────────── -->
  <% if (profile.reviews.count) { %>
    <section>
      <h2>Évaluations des experts</h2>
      <div class="card">
        <% profile.reviews.items.forEach(function (review) { %>
          <div class="review">
            <div class="stars" aria-label="<%= review.rating %> sur 5">
              <%= '★'.repeat(review.rating) %><span style="opacity:.28"><%= '★'.repeat(5 - review.rating) %></span>
            </div>
            <% if (review.comment) { %><p><%= review.comment %></p><% } %>
            <% if (review.author) { %><p class="who">— <%= review.author %></p><% } %>
          </div>
        <% }); %>
      </div>
    </section>
  <% } %>

  <!-- ── 5. Contact — masqué si aucun téléphone ─────────── -->
  <% if (profile.whatsappUrl) { %>
    <section>
      <h2>Contact</h2>
      <div class="card contact">
        <p>Un projet en tête ? Écrivez directement à <%= profile.firstName %>.</p>
        <a class="btn btn-wa" href="<%= profile.whatsappUrl %>" target="_blank" rel="noopener">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2z"/></svg>
          Discuter sur WhatsApp
        </a>
      </div>
    </section>
  <% } %>

  <!-- ── 6. Footer ──────────────────────────────────────── -->
  <footer>
    <p>
      <%= profile.fullName %> · <a href="<%= meta.url %>"><%= meta.host %></a><br>
      Propulsé par <a href="<%= meta.appUrl %>">BMP</a>
    </p>
  </footer>

</div>
</body>
</html>
